{
  "buildCommand": "node scripts/build-public.cjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/orientation.js": {
      "maxDuration": 60
    },
    "api/mission.js": {
      "maxDuration": 60
    },
    "api/agents.js": {
      "maxDuration": 60
    },
    "api/network.js": {
      "maxDuration": 20
    },
    "api/bridges.js": {
      "maxDuration": 20
    },
    "api/governance.js": {
      "maxDuration": 30
    },
    "api/budget.js": {
      "maxDuration": 20
    },
    "api/composio.js": {
      "maxDuration": 30
    },
    "api/panel.js": {
      "maxDuration": 20,
      "includeFiles": "*.html"
    },
    "api/session.js": {
      "maxDuration": 20
    },
    "api/gateway.js": {
      "maxDuration": 60
    },
    "api/attachments.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/panel?view=index"
    },
    {
      "source": "/index",
      "destination": "/api/panel?view=index"
    },
    {
      "source": "/index.html",
      "destination": "/api/panel?view=index"
    },
    {
      "source": "/network",
      "destination": "/api/panel?view=network"
    },
    {
      "source": "/network.html",
      "destination": "/api/panel?view=network"
    },
    {
      "source": "/governance",
      "destination": "/api/panel?view=governance"
    },
    {
      "source": "/governance.html",
      "destination": "/api/panel?view=governance"
    },
    {
      "source": "/budget",
      "destination": "/api/panel?view=budget"
    },
    {
      "source": "/budget.html",
      "destination": "/api/panel?view=budget"
    },
    {
      "source": "/index-operacional",
      "destination": "/api/panel?view=index"
    },
    {
      "source": "/index-operacional.html",
      "destination": "/api/panel?view=index"
    },
    {
      "source": "/gateway",
      "destination": "/api/panel?view=gateway"
    },
    {
      "source": "/gateway.html",
      "destination": "/api/panel?view=gateway"
    }
  ]
}
